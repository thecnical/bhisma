include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include config.yaml
include requirements.txt
include requirements-dev.txt

recursive-include bhisma/dashboard/templates *.html
recursive-include bhisma/dashboard/static/css *.css
recursive-include bhisma/dashboard/static/js *.js
recursive-include bhisma/dashboard/static/img *.png *.jpg *.svg

recursive-include docs *.md
recursive-include tests *.py

global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
